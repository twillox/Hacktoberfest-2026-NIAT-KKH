# BloodBridge Configuration

# Mode: 'demo' (built-in full local storage & mock adapters) or 'production' (real Firebase & APIs)
VITE_APP_MODE=demo

# Firebase Web Configuration (Optional in Demo Mode)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Emulator Hosts (Optional for local emulation)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# Google Gemma 4 / Gemini API (Optional - local fallback AI adapter used when blank)
VITE_GEMINI_API_KEY=your_gemini_api_key_for_gemma_4
VITE_GEMMA_MODEL_ID=gemma-4-it

# WhatsApp Business Cloud API (Server-side Cloud Functions config)
# Server secrets should be set in Firebase Functions config / Secret Manager:
# WHATSAPP_ACCESS_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=10987654321
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=bloodbridge_webhook_verify_secure_token
# WHATSAPP_APP_SECRET=your_app_secret
